<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" 
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
           xsi:type="MailApp">
  <Id>71234567-1234-1234-1234-1234567890ab</Id> <Version>1.0.0.0</Version>
  <ProviderName>Akos RFID</ProviderName>
  <DefaultLocale>hu-HU</DefaultLocale>
  <DisplayName DefaultValue="Monday Linker"/>
  <Description DefaultValue="Email beküldése a megfelelő monday projektbe linkkel."/>
  <IconUrl DefaultValue=https://kisako-spec.github.io/monday-outlook-addin//>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://kisako-spec.github.io/monday-outlook-addin/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="And">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>
</OfficeApp>
