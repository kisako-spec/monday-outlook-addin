<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="MailApp">

  <Id>71234567-1234-1234-1234-1234567890ab</Id>
  <Version>1.0.0.1</Version>
  <ProviderName>Flow &amp; Code by Kisari</ProviderName>
  <DefaultLocale>hu-HU</DefaultLocale>
  <DisplayName DefaultValue="Monday Linker"/>
  <Description DefaultValue="Email beküldése a megfelelő monday projektbe linkkel."/>

  <!-- Alap ikon a régi Outlook verziókhoz -->
  <IconUrl DefaultValue="https://kisako-spec.github.io/monday-outlook-addin/icon-32.png"/>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://kisako-spec.github.io/monday-outlook-addin/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="And">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <!-- Modern Outlook verziók: command surface / task pane -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
                    xsi:type="VersionOverridesV1_0">

    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="msgReadGroupLabel"/>

                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="msgReadButtonLabel"/>

                  <Supertip>
                    <Title resid="msgReadSuperTipTitle"/>
                    <Description resid="msgReadSuperTipDescription"/>
                  </Supertip>

                  <Icon>
                    <bt:Image size="16" resid="icon16"/>
                    <bt:Image size="32" resid="icon32"/>
                    <bt:Image size="80" resid="icon80"/>
                  </Icon>

                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="taskpaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://kisako-spec.github.io/monday-outlook-addin/icon-16.png"/>
        <bt:Image id="icon32" DefaultValue="https://kisako-spec.github.io/monday-outlook-addin/icon-32.png"/>
        <bt:Image id="icon80" DefaultValue="https://kisako-spec.github.io/monday-outlook-addin/icon-80.png"/>
      </bt:Images>

      <bt:Urls>
        <bt:Url id="taskpaneUrl" DefaultValue="https://kisako-spec.github.io/monday-outlook-addin/taskpane.html"/>
      </bt:Urls>

      <bt:ShortStrings>
        <bt:String id="msgReadGroupLabel" DefaultValue="Monday Kapcsolat"/>
        <bt:String id="msgReadButtonLabel" DefaultValue="Küldés Monday-be"/>
        <bt:String id="msgReadSuperTipTitle" DefaultValue="Monday Linker"/>
      </bt:ShortStrings>

      <bt:LongStrings>
        <bt:String id="msgReadSuperTipDescription" DefaultValue="Email beküldése a megfelelő projektbe."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
